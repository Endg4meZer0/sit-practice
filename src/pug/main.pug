extends layout

block header-tabs
  a.header__tabs-tab.header__tabs-tab--active(href="#") Операционные системы
  a.header__tabs-tab(href="list.html") Рейтинг операционных систем

block content
  section.main-images
    each image in [{src: 'https://thefrisky.com/wp-content/uploads/2019/01/windows-logo-1.png', href: 'more.html'},{src: 'https://logospng.org/download/apple/logo-apple-1024.png', href: '#'},{src: 'https://brandslogos.com/wp-content/uploads/images/large/linux-tux-logo-1.png', href: '#'},{src: 'https://brandslogos.com/wp-content/uploads/images/large/linux-tux-logo-1.png', href: '#'},{src: 'https://logospng.org/download/apple/logo-apple-1024.png', href: '#'},{src: 'https://thefrisky.com/wp-content/uploads/2019/01/windows-logo-1.png', href: 'more.html'}]
      a.main-images__item(href=image.href)
        img(src=image.src)
  section.main-area
    each block in [{type: 'small', title: 'Заголовок', text: 'Lorem ipsum', img: 'https://logospng.org/download/apple/logo-apple-1024.png', col: 2, row: 1},{type: 'big', title: 'Заголовок', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Etiam lobortis, sapien at blandit varius, diam ante aliquet nulla, at rutrum erat metus vitae lacus.', img: 'https://logospng.org/download/apple/logo-apple-1024.png', col: 1, row: 2, inverted: false},{type: 'small', title: 'Заголовок', text: 'Lorem ipsum', img: 'https://logospng.org/download/apple/logo-apple-1024.png', col: 2, row: 3},{type: 'big', title: 'Заголовок', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Etiam lobortis, sapien at blandit varius, diam ante aliquet nulla, at rutrum erat metus vitae lacus.', img: 'https://logospng.org/download/apple/logo-apple-1024.png', col: 3, row: 2, inverted: true},{type: 'small', title: 'Заголовок', text: 'Lorem ipsum', img: 'https://logospng.org/download/apple/logo-apple-1024.png', col: 4, row: 1},{type: 'big', title: 'Заголовок', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Etiam lobortis, sapien at blandit varius, diam ante aliquet nulla, at rutrum erat metus vitae lacus.', img: 'https://logospng.org/download/apple/logo-apple-1024.png', col: 5, row: 2, inverted: false},{type: 'small', title: 'Заголовок', text: 'Lorem ipsum', img: 'https://logospng.org/download/apple/logo-apple-1024.png', col: 4, row: 3}]
      if block.type === 'small'
        div(class="main-area__block main-area__block--small main-area__block--col" + block.col + " main-area__block--row" + block.row)
          img(src=block.img)
          p.main-area__title= block.title
          p.main-area__text= block.text
      else if block.type === 'big'
        if !block.inverted
            div(class="main-area__block main-area__block--big main-area__block--col" + block.col + " main-area__block--row" + block.row)
                p.main-area__title= block.title
                p.main-area__text= block.text
                img(src=block.img)
                div.main-area__more
                    a.main-area__more-link(href="#") Подробнее
        else
            div(class="main-area__block main-area__block--big main-area__block--col" + block.col + " main-area__block--row" + block.row)
                img(src=block.img)
                p.main-area__title= block.title
                p.main-area__text= block.text
                div.main-area__more.main-area__more--inverted
                    a.main-area__more-link(href="#") Подробнее