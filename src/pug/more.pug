extends layout

block header-tabs
  a.header__tabs-tab(href="main.html") Операционные системы
  a.header__tabs-tab.header__tabs-tab--active(href="#") Windows
  a.header__tabs-tab(href="list.html") Рейтинг операционных систем

block content
  section.more
    img.more__image(src="https://thefrisky.com/wp-content/uploads/2019/01/windows-logo-1.png" width="240" height="240")
    each paragraph in ['Операционная система Microsoft Windows, бесспорно, является самой узнаваемой и распространенной платформой для настольных компьютеров в мире.','Ключевым преимуществом Windows всегда была ее аппаратная универсальность.','Еще одним решающим фактором доминирования Windows является экосистема программного обеспечения.','Современный облик Windows — это эргономичный и функциональный интерфейс.']
      p.more__text= paragraph